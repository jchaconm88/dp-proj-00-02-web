rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    function isPlatformAdmin() {
      return isSignedIn()
        && (
          request.auth.token.platformAdmin == true
          || isLegacyAdmin()
        );
    }

    // Compatibilidad: bootstrap legacy "admin" (sin claims aún).
    // Acepta `users/{uid}.roleIds` o `users/{uid}.role` con "admin", o "admin" en `company-users.roleIds`.
    function isLegacyAdmin() {
      return isSignedIn()
        && (
          (
            exists(/databases/$(database)/documents/users/$(myUid()))
            && (
              (
                get(/databases/$(database)/documents/users/$(myUid())).data.roleIds is list
                && get(/databases/$(database)/documents/users/$(myUid())).data.roleIds.hasAny(["admin"])
              )
              || (
                get(/databases/$(database)/documents/users/$(myUid())).data.role is list
                && get(/databases/$(database)/documents/users/$(myUid())).data.role.hasAny(["admin"])
              )
            )
          )
          || (
            // Membresía: `company-users/{companyId_uid}` puede traer slug "admin" temporalmente.
            request.auth.token.companyId is string
            && request.auth.token.companyId.size() > 0
            && exists(/databases/$(database)/documents/company-users/$(companyUserId(request.auth.token.companyId, myUid())))
            && (
              get(/databases/$(database)/documents/company-users/$(companyUserId(request.auth.token.companyId, myUid()))).data.roleIds is list
              && get(/databases/$(database)/documents/company-users/$(companyUserId(request.auth.token.companyId, myUid()))).data.roleIds.hasAny(["admin"])
            )
          )
        );
    }

    function tokenHasPermission(module, action) {
      return isSignedIn()
        && (
          isPlatformAdmin()
          || (
            request.auth.token.permissionCodes is list
            && request.auth.token.permissionCodes.hasAny([
              "*",
              module + ":" + action,
              "*:" + module
            ])
          )
        );
    }

    function canReadUsersCollection() {
      return isSignedIn()
        && (
          tokenHasPermission("user", "view")
          || isPlatformAdmin()
        );
    }

    /** Id de documento en `company-users`: `${companyId}_${uid}` */
    function companyUserId(companyId, uid) {
      return companyId + "_" + uid;
    }

    function isMember(companyId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/company-users/$(companyUserId(companyId, myUid())))
        && get(/databases/$(database)/documents/company-users/$(companyUserId(companyId, myUid()))).data.status != "inactive";
    }

    /** Compatibilidad: sin accountId en doc o sin claim aún, o coinciden. */
    function legacyOrTokenAccountMatches() {
      return !('accountId' in resource.data)
        || resource.data.accountId == null
        || !('accountId' in request.auth.token)
        || request.auth.token.accountId == null
        || request.auth.token.accountId == resource.data.accountId;
    }

    function accountMatchesData(data) {
      return !('accountId' in data)
        || data.accountId == null
        || !('accountId' in request.auth.token)
        || request.auth.token.accountId == null
        || request.auth.token.accountId == data.accountId;
    }

    function effectiveCompanyId() {
      return request.method == "create"
        ? request.resource.data.companyId
        : resource.data.companyId;
    }

    function effectiveAccountMatches() {
      return request.method == "create"
        ? accountMatchesData(request.resource.data)
        : accountMatchesData(resource.data);
    }

    function canManageCompanyUsers(companyId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/company-users/$(companyUserId(companyId, myUid())))
        && get(/databases/$(database)/documents/company-users/$(companyUserId(companyId, myUid()))).data.status != "inactive"
        && tokenHasPermission("user", "edit");
    }

    // Perfiles: colección `users` (alineado con ~/lib/auth-context).
    // Lectura también si el email del documento coincide con el token (perfiles legacy con docId != Auth UID).
    match /users/{userId} {
      allow read: if isSignedIn()
        && (
          request.auth.uid == userId
          || (
            resource.data.email is string
            && request.auth.token.email != null
            && resource.data.email == request.auth.token.email
          )
          || canReadUsersCollection()
        );
      allow write: if isSignedIn()
        && (request.auth.uid == userId || isPlatformAdmin())
        && (
          isPlatformAdmin()
          || !('accountId' in request.resource.data)
          || request.resource.data.accountId == null
          || !('accountId' in request.auth.token)
          || request.auth.token.accountId == null
          || request.resource.data.accountId == request.auth.token.accountId
        );
    }

    match /companies/{companyId} {
      allow read: if (isMember(companyId) || isPlatformAdmin()) && legacyOrTokenAccountMatches();
      allow write: if isPlatformAdmin();

      /** Sedes / ubicaciones de facturación (companyLocations). */
      match /companyLocations/{locationId} {
        allow read: if isSignedIn() && isMember(companyId) && legacyOrTokenAccountMatches();
        allow create: if isSignedIn()
          && isMember(companyId)
          && request.resource.data.companyId == companyId
          && accountMatchesData(request.resource.data);
        allow update: if isSignedIn()
          && isMember(companyId)
          && resource.data.companyId == companyId
          && accountMatchesData(request.resource.data);
        allow delete: if isSignedIn()
          && isMember(companyId)
          && resource.data.companyId == companyId
          && legacyOrTokenAccountMatches();
      }
    }

    /** Catálogo SaaS (límites / features); distinto de trip-plans. */
    match /plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isPlatformAdmin();
    }

    /** Configuración dinámica del dashboard (métricas/tarjetas). */
    match /metric-definitions/{metricId} {
      allow read: if isSignedIn();
      allow write: if isPlatformAdmin();
    }

    match /dashboard-card-definitions/{cardId} {
      allow read: if isSignedIn();
      allow write: if isPlatformAdmin();
    }

    match /usage-months/{usageId} {
      allow read: if isSignedIn() && (isPlatformAdmin() || !('accountId' in resource.data) || !('accountId' in request.auth.token) || request.auth.token.accountId == null || resource.data.accountId == request.auth.token.accountId);
      allow write: if isPlatformAdmin();
    }

    match /company-users/{companyUserDocId} {
      allow read: if isSignedIn();
      allow create: if isPlatformAdmin()
        || (isSignedIn()
          && request.resource.data.companyId is string
          && request.resource.data.companyId.size() > 0
          && request.resource.data.userId is string
          && request.resource.data.userId.size() > 0
          && canManageCompanyUsers(request.resource.data.companyId));
      allow update: if isPlatformAdmin()
        || (isSignedIn()
          && resource.data.companyId == request.resource.data.companyId
          && request.resource.data.userId is string
          && request.resource.data.userId.size() > 0
          // Compatibilidad de transición: valida contra el ID del doc, no contra campo legacy.
          && companyUserDocId == (resource.data.companyId + "_" + request.resource.data.userId)
          && canManageCompanyUsers(resource.data.companyId));
      allow delete: if isPlatformAdmin()
        || (isSignedIn() && canManageCompanyUsers(resource.data.companyId));
    }

    match /counters/{docId} {
      allow read, write: if isSignedIn() && isMember(effectiveCompanyId()) && effectiveAccountMatches();
    }

    match /sunat-jobs/{jobId} {
      allow read: if isSignedIn()
        && resource.data.companyId is string
        && isMember(resource.data.companyId)
        && legacyOrTokenAccountMatches();
      allow write: if false;
    }

  }
}
