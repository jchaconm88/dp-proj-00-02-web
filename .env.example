# ============================================================
# VARIABLES DE ENTORNO — dp-proj-00-02-web
# ============================================================
# Copia este archivo a .env y rellena con los valores reales
# del proyecto Firebase del ambiente (output de dp-proj-00-02-infra).
# ============================================================

# Firebase (unificado por ambiente)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Backend (Cloud Run) ──────────────────────────────────────
#
# DESARROLLO LOCAL (recomendado):
#   - Deja VITE_WEB_BACKEND_BASE_URL vacío o comentado
#   - Define VITE_WEB_BACKEND_PROXY_TARGET con la URL de Cloud Run
#   - Vite redirigirá /web-backend/* a <target>/web (sin CORS)
#
# PRODUCCIÓN (build/hosting):
#   - Define VITE_WEB_BACKEND_BASE_URL con la URL absoluta de Cloud Run + /web
#     (ej. https://<servicio>.a.run.app/web)
#   - VITE_WEB_BACKEND_PROXY_TARGET se ignora en producción
#
# VITE_WEB_BACKEND_BASE_URL=https://<tu-servicio>.a.run.app/web
VITE_WEB_BACKEND_PROXY_TARGET=https://<tu-servicio>.a.run.app

# Opcional: usar emuladores locales durante desarrollo
# VITE_USE_FIREBASE_EMULATORS=true
